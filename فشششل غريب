import { debounce } from '../utils/debounce.js';

const config = window.appConfig;
const input = document.querySelector('#global-search-input');
const panel = document.querySelector('[data-js="global-search-results"]');

const renderResults = (items = []) => {
  if (!items.length) {
    panel.innerHTML = `<li class="global-search__empty">مفيش دروس بالكلمة دي</li>`;
    panel.hidden = false;
    return;
  }
  panel.innerHTML = items.map((lesson) => `
    <li>
      <a href="/website.html?lesson=${lesson._id}">
        <strong>${lesson.title}</strong>
        <span>${lesson.sheikhName} · ${lesson.categoryName}</span>
        <p>${lesson.matchSnippet}</p>
      </a>
    </li>`).join('');
  panel.hidden = false;
};

const performSearch = debounce(async (term) => {
  if (term.length < config.search.minQueryLength) {
    panel.hidden = true;
    return;
  }
  panel.dataset.state = 'loading';
  try {
    const res = await fetch(`/api/public/search?q=${encodeURIComponent(term)}`);
    const payload = await res.json();
    panel.dataset.state = 'idle';
    renderResults(payload.results);
  } catch {
    panel.dataset.state = 'error';
    panel.innerHTML = `<li class="global-search__error">حصل خطأ، جرّب تاني.</li>`;
    panel.hidden = false;
  }
}, config.search.debounceMs);

input?.addEventListener('input', (e) => performSearch(e.target.value));
document.addEventListener('click', (ev) => {
  if (!panel.contains(ev.target) && ev.target !== input) {
    panel.hidden = true;
  }
});
