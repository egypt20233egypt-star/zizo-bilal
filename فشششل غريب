const tracker = (() => {
  const storageKey = window.appConfig.storageKeys.progress;
  const read = () => JSON.parse(localStorage.getItem(storageKey) || '{}');
  const write = (payload) => localStorage.setItem(storageKey, JSON.stringify(payload));

  const broadcast = new BroadcastChannel('progress-tracker');
  broadcast.onmessage = (event) => {
    if (event.data === 'sync') {
      document.dispatchEvent(new CustomEvent('progress:sync'));
    }
  };

  return {
    markRead({ lessonId, sheikhId }) {
      const state = read();
      if (!state[sheikhId]) state[sheikhId] = new Set();
      const entries = new Set(state[sheikhId]);
      if (!entries.has(lessonId)) {
        entries.add(lessonId);
        state[sheikhId] = [...entries];
        write(state);
        broadcast.postMessage('sync');
      }
    },
    isRead({ lessonId, sheikhId }) {
      const state = read();
      return Boolean(state[sheikhId]?.includes(lessonId));
    },
    countBySheikh() {
      const state = read();
      return Object.fromEntries(Object.entries(state).map(([id, list]) => [id, list.length]));
    }
  };
})();
export default tracker;

