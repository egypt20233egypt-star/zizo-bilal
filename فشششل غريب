const breadcrumb = (() => {
  const flag = window.appConfig.featureFlags.breadcrumbs;
  const container = document.querySelector('[data-js="breadcrumb"]');
  if (!flag || !container) return;

  const buildCrumbs = (items) => items.map((item, idx) => `
    <span class="breadcrumb__item">
      ${item.href && idx !== items.length - 1
        ? `<a href="${item.href}">${item.label}</a>`
        : `<span aria-current="page">${item.label}</span>`}
    </span>
  `).join('<span class="breadcrumb__sep">›</span>');

  return {
    mount(items = []) { container.innerHTML = buildCrumbs(items); }
  };
})();

