// routes/public.js
const express = require('express');
const router = express.Router();
const Lesson = require('../models/Lesson');
const Sheikh = require('../models/Sheikh');

// Helper: Sanitize Regex
const escapeRegex = (string) => {
    return string.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
};

router.get('/search', async (req, res) => {
    try {
        const { q } = req.query;
        if (!q || q.length < 2) return res.json([]);

        // Security: Prevent ReDoS by limiting complexity
        const sanitizedQuery = escapeRegex(q);
        const regex = new RegExp(sanitizedQuery, 'i'); // Case-insensitive

        const lessons = await Lesson.find({
            $or: [
                { title: regex },
                { rawSource: regex }
            ]
        })
        .limit(parseInt(process.env.SEARCH_LIMIT) || 20)
        .populate('sheikh', 'name')
        .populate('category', 'name')
        .lean();

        // Format response (SSOT)
        const results = lessons.map(l => ({
            _id: l._id,
            title: l.title,
            sheikhName: l.sheikh?.name || 'Unknown',
            categoryName: l.category?.name || 'General',
            // Highlight match (simple substring for performance)
            matchSnippet: l.title.substring(0, 50) + '...' 
        }));

        res.json(results);
    } catch (err) {
        console.error('Search Error:', err);
        res.status(500).json({ message: 'Server error' });
    }
});

module.exports = router;
