const escapeRegex = (term = '') => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

const buildSearchFilter = (term) => ({
  $or: [
    { title: { $regex: term, $options: 'i' } },
    { rawSource: { $regex: term, $options: 'i' } }
  ]
});

const formatSnippet = (content, term, length) => {
  const idx = content.toLowerCase().indexOf(term.toLowerCase());
  if (idx === -1) return content.slice(0, length) + '…';
  const start = Math.max(0, idx - length / 2);
  return `${content.slice(start, start + length)}…`;
};

module.exports = {
  searchLessons: async ({ term, LessonModel, config }) => {
    const safeTerm = escapeRegex(term.trim());
    const filter = buildSearchFilter(safeTerm);
    const docs = await LessonModel.aggregate([
      { $match: filter },
      {
        $project: {
          title: 1,
          sheikhName: 1,
          categoryName: 1,
          rawSource: 1
        }
      },
      { $limit: config.search.maxResults }
    ]);
    return docs.map((doc) => ({
      _id: doc._id,
      title: doc.title,
      sheikhName: doc.sheikhName,
      categoryName: doc.categoryName,
      matchSnippet: formatSnippet(doc.rawSource || '', term, config.search.snippetLength)
    }));
  }
};
