const STORAGE_KEY = 'read_lessons'; // SSOT

class ProgressTracker {
  static getReadLessons() {
    return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
  }

  static markAsRead(lessonId) {
    const read = this.getReadLessons();
    if (!read.includes(lessonId)) {
      read.push(lessonId);
      localStorage.setItem(STORAGE_KEY, JSON.stringify(read));
    }
  }

  static isRead(lessonId) {
    return this.getReadLessons().includes(lessonId);
  }

  static getProgressForSheikh(sheikhId, allLessons) {
    const sheikhs = allLessons.filter(l => l.sheikhId === sheikhId);
    const read = sheikhs.filter(l => this.isRead(l._id));
    return { total: sheikhs.length, read: read.length };
  }

  static clear() {
    localStorage.removeItem(STORAGE_KEY);
  }
}

export default ProgressTracker;
