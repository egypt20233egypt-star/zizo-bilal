3. Search Bar Logic (أضفه لـ js/search.js):

javascript
// js/search.js
function initSearch() {
    const input = document.getElementById('global-search');
    const dropdown = document.getElementById('search-results');
    let timeout = null;

    input.addEventListener('input', (e) => {
        clearTimeout(timeout);
        const query = e.target.value.trim();

        if (query.length < 2) {
            dropdown.style.display = 'none';
            return;
        }

        timeout = setTimeout(async () => {
            try {
                const res = await fetch(`${APP_CONFIG.API_BASE}/search?q=${encodeURIComponent(query)}`);
                const data = await res.json();
                
                if (data.length > 0) {
                    dropdown.innerHTML = data.map(item => `
                        <a href="/website?lesson=${item._id}" class="search-item">
                            <strong>${highlightMatch(item.title, query)}</strong>
                            <small>${item.sheikhName} - ${item.categoryName}</small>
                        </a>
                    `).join('');
                    dropdown.style.display = 'block';
                } else {
                    dropdown.innerHTML = '<div class="no-results">مفيش دروس بالكلمة دي</div>';
                    dropdown.style.display = 'block';
                }
            } catch (err) {
                console.error('Search failed', err);
            }
        }, APP_CONFIG.SEARCH_DEBOUNCE_MS);
    });
}

function highlightMatch(text, query) {
    const regex = new RegExp(`(${query})`, 'gi');
    return text.replace(regex, '<mark>$1</mark>');
}
